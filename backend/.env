# Docker Compose environment for the Kopa backend. Mirrors kopa-config.yml (which is only read
# when running services directly on the host, via its hardcoded absolute path import) but with
# container-network hostnames for Postgres/RabbitMQ/inter-service URLs instead of localhost.
# Same secrets, same rigor level as kopa-config.yml - not a real vault, acceptable for this stage.

# --- Postgres ---
POSTGRES_DB=kopa_db
KOPA_DB_URL=jdbc:postgresql://postgres:5432/kopa_db
KOPA_DB_USERNAME=postgres
KOPA_DB_PASSWORD=dbroot#137
KOPA_DB_DRIVER=org.postgresql.Driver

# --- RabbitMQ ---
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
APP_MESSAGING_EXCHANGE=kopa.events

# --- RBSS-CCBS (KTRN) gateway - real external endpoint, only reachable from Kopa's network/VPN.
# Unchanged from kopa-config.yml: container networking doesn't affect reachability to this one,
# whichever host runs the kopa-middleware-ktrn container still needs that VPN tunnel. ---
KOPA_KTRN_BASE_URL=http://192.168.21.7:8086/cloud/ktrn/bss
KOPA_KTRN_EXTERNAL_BASE_URL=http://www.4glte.rw/voucher/api/external_access.jsp
KOPA_KTRN_ISP_CD=1

# --- Kopa's own KTRN-assigned identifiers ---
KOPA_BUSINESS_SO_ID=1
KOPA_BUSINESS_ORG_ID=NZ00000221
KOPA_BUSINESS_LOGIN_ID=armapoc

# --- Where each Microservice reaches its Middleware - container service names, not localhost ---
KOPA_MIDDLEWARE_KTRN_BASE_URL=http://kopa-middleware-ktrn:8082/kopa-middleware-ktrn
KOPA_MIDDLEWARE_SMS_BASE_URL=http://kopa-middleware-sms:8086/kopa-middleware-sms

# --- Where customer-identity/customer-self-care reach kopa.notifications ---
KOPA_NOTIFICATIONS_BASE_URL=http://kopa-notifications:8084/kopa-notifications

# --- InTouch bulk SMS gateway - real external endpoint, unchanged from kopa-config.yml ---
KOPA_SMS_INTOUCH_BASE_URL=https://www.intouchsms.co.rw/api/sendsms/.json
KOPA_SMS_INTOUCH_USERNAME=kopa.telecom
KOPA_SMS_INTOUCH_PASSWORD=kopa.telecom
KOPA_SMS_DEFAULT_SENDER=KOPATELECOM

# --- X-Internal-Api-Key secrets for /internal/v1/** - one per TARGET service (2026-10-20
# hardening pass), same values as kopa-config.yml ---
KOPA_INTERNAL_MIDDLEWARE_KTRN_API_KEY=dd0946488939a268e0cebc1d318e69ef2dcb83bef07a2786
KOPA_INTERNAL_MIDDLEWARE_SMS_API_KEY=bf79380a1183f828f1674c9e258fd6312ba632dbae557a78
KOPA_INTERNAL_NOTIFICATIONS_API_KEY=bca003ebff13dc842dc9cb5410196c30a399414a90a23786

# --- CORS ---
KOPA_WEB_ALLOWED_ORIGINS=http://localhost:3000
